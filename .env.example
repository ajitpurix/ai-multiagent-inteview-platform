# ==============================================================================
# GLOBAL MONOREPO ENVIRONMENT VARIABLES
# ==============================================================================
NODE_ENV=development
ENVIRONMENT=development

# --- Web Frontend ---
PORT_WEB=3000
NEXT_PUBLIC_API_GATEWAY_URL=http://localhost:8000
NEXT_PUBLIC_WS_GATEWAY_URL=ws://localhost:8000

# --- API Gateway ---
PORT_API_GATEWAY=8000
JWT_SECRET=super-secret-jwt-key-replace-in-production-min-32-chars
JWT_EXPIRES_IN=1d

# --- Microservices Internal Ports ---
PORT_AUTH_SERVICE=8001
PORT_USER_SERVICE=8002
PORT_INTERVIEW_SERVICE=8003
PORT_REPORT_SERVICE=8004
PORT_CODING_SERVICE=8005
PORT_AI_SERVICE=8006

# --- Database & Cache Configurations ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_interview_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_interview_db

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- Message Broker (RabbitMQ / Kafka) ---
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# --- AI Service (Python / FastAPI / Multi-Agent) ---
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here
DEFAULT_LLM_PROVIDER=openai
DEFAULT_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small
VECTOR_DB_TYPE=chroma # chroma | qdrant | pgvector
CHROMA_PERSIST_DIRECTORY=./services/ai-service/chroma_db

# --- Code Execution Sandboxing (coding-service) ---
CODE_EXEC_TIMEOUT_MS=5000
MAX_MEMORY_MB=128
SANDBOX_PROVIDER=docker # docker | isolate | judge0

# --- Cloud Storage & AWS ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
S3_BUCKET_RESUMES=ai-interview-resumes-dev
S3_BUCKET_REPORTS=ai-interview-reports-dev
